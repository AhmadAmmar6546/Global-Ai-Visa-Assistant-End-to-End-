# Local development values only; replace database credentials for deployment.
DATABASE_URL="postgresql://visa:visa_local_development@127.0.0.1:5432/visa?schema=public"
POSTGRES_USER=visa
POSTGRES_PASSWORD=visa_local_development
POSTGRES_DB=visa
APP_URL=http://localhost:3000
AI_PROVIDER=local
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash-lite
AI_DAILY_BUDGET_TOKENS=10000
# Server-side secrets only. Leave empty for usable local guidance.
GEMINI_API_KEY=
AI_API_KEY=
OPENAI_API_KEY=
# Optional transactional email via Resend. Production verification/reset needs this.
RESEND_API_KEY=
EMAIL_FROM=
